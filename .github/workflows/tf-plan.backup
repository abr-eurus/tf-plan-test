name: Terraform Plan & Apply

on:
  push:
    branches: [main]
  #   paths:
  #     - 'terraform/**'
  # pull_request:
  #   branches: [main]
  #   paths:
  #     - 'terraform/**'
  workflow_dispatch: {}

permissions:
  contents: write
  pull-requests: write

env:
  TF_WORKING_DIR: infra
  TF_VERSION: "1.15.8"

jobs:
  # -----------------------------------------------------------------
  # 1. PLAN — runs on every push/PR, no approval needed
  # -----------------------------------------------------------------
  plan:
    name: Terraform Plan
    runs-on: ubuntu-latest
    outputs:
      plan-outcome: ${{ steps.plan.outcome }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}

      - name: Terraform Init
        working-directory: ${{ env.TF_WORKING_DIR }}
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
        run: terraform init -input=false

      - name: Terraform Validate
        working-directory: ${{ env.TF_WORKING_DIR }}
        run: terraform validate

      - name: Terraform Plan
        id: plan
        working-directory: ${{ env.TF_WORKING_DIR }}
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
        run: |
          terraform plan -input=false -out=plan.tfplan
          terraform show -json plan.tfplan > plan.json
        continue-on-error: false

      - name: Download Plan Visualizer binary
        run: |
          curl -L -o terraform-plan-visualizer \
            https://github.com/cloudvic-org/terraform-plan-visualizer/releases/download/v1.0.1/terraform-plan-visualizer-linux-amd64
          chmod +x terraform-plan-visualizer

      - name: Generate Plan Visualization
        run: ./terraform-plan-visualizer -i ${{ env.TF_WORKING_DIR }}/plan.json -o plan-visualization.html

      - name: Upload plan file (for apply job)
        uses: actions/upload-artifact@v4
        with:
          name: tfplan
          path: ${{ env.TF_WORKING_DIR }}/plan.tfplan
          retention-days: 5
      
      - name: Extract plan stats
        id: stats
        working-directory: ${{ env.TF_WORKING_DIR }}
        run: |
          ADD=$(jq '[.resource_changes[]? | select(.change.actions == ["create"])] | length' plan.json)
          CHANGE=$(jq '[.resource_changes[]? | select(.change.actions == ["update"])] | length' plan.json)
          DESTROY=$(jq '[.resource_changes[]? | select(.change.actions == ["delete"])] | length' plan.json)
          REPLACE=$(jq '[.resource_changes[]? | select(.change.actions == ["delete","create"] or .change.actions == ["create","delete"])] | length' plan.json)
          echo "add=$ADD" >> "$GITHUB_OUTPUT"
          echo "change=$CHANGE" >> "$GITHUB_OUTPUT"
          echo "destroy=$DESTROY" >> "$GITHUB_OUTPUT"
          echo "replace=$REPLACE" >> "$GITHUB_OUTPUT"

      - name: Set visualization path
        id: viz-path
        run: |
          if [ "${{ github.event_name }}" = "pull_request" ]; then
            echo "path=pr-${{ github.event.pull_request.number }}" >> "$GITHUB_OUTPUT"
          else
            echo "path=run-${{ github.run_id }}" >> "$GITHUB_OUTPUT"
          fi

      - name: Prepare visualization for Pages
        run: |
          mkdir -p pages-out
          cp plan-visualization.html pages-out/plan-visualization.html


      - name: Publish visualization to GitHub Pages
        uses: peaceiris/actions-gh-pages@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_branch: gh-pages
          publish_dir: pages-out
          destination_dir: ${{ steps.viz-path.outputs.path }}
          keep_files: true

      - name: Build Job Summary
        run: |
          OWNER="${{ github.repository_owner }}"
          REPO="${{ github.event.repository.name }}"
          PAGES_URL="https://${OWNER}.github.io/${REPO}/${{ steps.viz-path.outputs.path }}/plan-visualization.html"

          {
            echo "## 🪄 Terraform Plan Summary"
            echo ""
            echo "| ✅ Add | 🔄 Change | ♻️ Replace | ❌ Destroy |"
            echo "|:---:|:---:|:---:|:---:|"
            echo "| ${{ steps.stats.outputs.add }} | ${{ steps.stats.outputs.change }} | ${{ steps.stats.outputs.replace }} | ${{ steps.stats.outputs.destroy }} |"
            echo ""
            echo "[![View Interactive Plan Visualization](https://img.shields.io/badge/View-Interactive%20Plan%20Visualization-2ea44f?style=for-the-badge&logo=terraform&logoColor=white)]($PAGES_URL)"
            echo ""
            echo "_Working dir: \`${{ env.TF_WORKING_DIR }}\` • Terraform \`${{ env.TF_VERSION }}\` • Run [#${{ github.run_number }}](${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }})_"
          } >> "$GITHUB_STEP_SUMMARY"

  apply:
    name: Terraform Apply
    needs: plan
    # if: github.ref == 'refs/heads/main' && github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    environment:
      name: production   # <-- configure this environment's "required reviewers" in repo Settings
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}

      - name: Terraform Init
        working-directory: ${{ env.TF_WORKING_DIR }}
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
        run: terraform init -input=false

      - name: Download plan file
        uses: actions/download-artifact@v4
        with:
          name: tfplan
          path: ${{ env.TF_WORKING_DIR }}

      # - name: Terraform Apply
      #   working-directory: ${{ env.TF_WORKING_DIR }}
      #   env:
      #     AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
      #     AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
      #   run: terraform apply -input=false -auto-approve plan.tfplan